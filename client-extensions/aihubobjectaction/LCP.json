{
	"cpu": 0.5,
	"env": {
		"PORT": "8081",
		"LIFERAY_BASE_URL": "https://webserver-lctdemoibaihub-prd.lfr.cloud",
		"LIFERAY_VERIFY_SSL": "True",
		"AIHUB_AGENT_ERC": "JMR_AGENT_PRESS_RELEASES",
		"AIHUB_SERVICE_URL": "https://ai.hub.liferay.com",
		"LIFERAY_ROUTES_CLIENT_EXTENSION": "/etc/liferay/lxc/ext-init-metadata",
		"LIFERAY_ROUTES_DXP": "/etc/liferay/lxc/dxp-metadata"
	},
	"environments": {
		"infra": {
			"deploy": false
		}
	},
	"id": "__PROJECT_ID__",
	"kind": "Deployment",
	"livenessProbe": {
		"httpGet": {
			"path": "/ready",
			"port": 8081
		}
	},
	"loadBalancer": {
		"targetPort": 8081
	},
	"memory": 512,
	"readinessProbe": {
		"httpGet": {
			"path": "/ready",
			"port": 8081
		}
	},
	"scale": 1
}
